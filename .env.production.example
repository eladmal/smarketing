# =============================================
#  Smarketing — Production Environment
#  Copy to .env.production and fill in values
# =============================================

# ── App ───────────────────────────────────────
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://yourdomain.com

# ── Database ──────────────────────────────────
# Option A: Use the Compose PostgreSQL container
DATABASE_URL=postgresql://smarketing:CHANGE_ME@db:5432/smarketing
POSTGRES_DB=smarketing
POSTGRES_USER=smarketing
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# Option B: Managed PostgreSQL (DigitalOcean / Supabase / Neon)
# DATABASE_URL=postgresql://user:pass@host:25060/smarketing?sslmode=require

# ── JWT ───────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# ── Anthropic (Claude AI) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these in Stripe Dashboard → Products → Prices
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── Token Encryption ──────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=GENERATE_64_CHAR_HEX_STRING

# ── Trial Period ──────────────────────────────
TRIAL_DAYS=14

# ── Docker Registry ───────────────────────────
# e.g.: ghcr.io/yourgithubuser  OR  yourdockerhubuser
DOCKER_REGISTRY=ghcr.io/GITHUB_USERNAME
IMAGE_TAG=latest

# ── Platforms (fill when ready) ───────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
