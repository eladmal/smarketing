# Database
DATABASE_URL=postgresql://user:password@localhost:5432/smarketing

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
PORT=8000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Uploads
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# Platforms (add when ready)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Encryption key for OAuth tokens (32 chars)
TOKEN_ENCRYPTION_KEY=change-this-32-char-key-production
